# Copy to .env at the repository root. Every app (server, agent, indexer, web) reads this one file.

# ---- LiveKit Cloud (cloud.livekit.io -> project -> Settings -> Keys) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Anthropic (console.anthropic.com) ----
ANTHROPIC_API_KEY=
# Model used to write answers and maintain meeting memory
ANSWER_MODEL=claude-opus-5-5
MEMORY_MODEL=claude-opus-5-5
# Fast model used only to decide whether a transcript line is an engineering question
CLASSIFIER_MODEL=claude-haiku-5-5

# ---- Embeddings (dash.voyageai.com). Set EMBEDDINGS_PROVIDER=fake for offline tests ----
EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=
# voyage-code-4 is the current code model (1024 dims); voyage-code-3 also works. Changing the model rebuilds the index.
EMBEDDING_MODEL=voyage-code-4

# ---- Qdrant (local binary started with `npm run qdrant`, or Qdrant Cloud) ----
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=code_chunks

# ---- Speech to text used by the agent: livekit (LiveKit Inference) or deepgram ----
STT_PROVIDER=livekit
DEEPGRAM_API_KEY=

# ---- Server ----
PORT=8787
# Directory for the embedded PostgreSQL (PGlite) files, relative to the repo root
DATA_DIR=./data
# Shared secret the agent sends on internal requests to the server
INTERNAL_API_SECRET=change-me-to-a-long-random-string
# Where the agent reaches the server
SERVER_URL=http://127.0.0.1:8787
# Default project (index name) new meetings are scoped to
DEFAULT_PROJECT_ID=default
LOG_LEVEL=info

# ---- Web client (Vite reads VITE_* from this file) ----
VITE_SERVER_URL=http://127.0.0.1:8787
