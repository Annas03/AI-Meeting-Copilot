{
  "name": "@copilot/agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI participant: joins LiveKit rooms, transcribes every speaker, publishes captions and feeds the server",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts dev",
    "start": "tsx src/main.ts start",
    "connect": "tsx src/main.ts connect --room",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@copilot/shared": "0.1.0",
    "@livekit/agents": "1.9.3",
    "@livekit/agents-plugin-deepgram": "1.9.3",
    "@livekit/rtc-node": "^1.1.0",
    "dotenv": "^18.0.8"
  }
}
